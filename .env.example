# Configure exclusively on the server. Never expose keys through VITE_*.
RESEND_API_KEY=
LEADS_FROM=no-reply@alamoengenharia.com.br
# Compatible CRM gateway; native Zoho API uses a different OAuth contract.
CRM_GATEWAY_URL=
CRM_GATEWAY_API_KEY=
CRM_CONNECTION_API_KEY=
ZOHO_WEBFORM_URL=
# Optional narration gateway: Gemini AUDIO request + SSE PCM 24 kHz response.
SPEECH_GATEWAY_URL=
SPEECH_GATEWAY_API_KEY=
SPEECH_MODEL=google/gemini-3.1-flash-tts-preview
